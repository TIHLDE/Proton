{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": { "ignoreUnknown": false, "ignore": [] },
	// src/components/ui/* er ordrette kopier fra Photon. Formaterer biome dem,
	// slutter de å være byte-like med kilden og synk blir umulig å lese.
	"formatter": { "enabled": true, "ignore": ["src/components/ui/**"] },
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"ignore": [
			"src/components/event-calendar/**/*",
			// Hentet uendret fra Photon (packages/ui) for at velgerne skal være
			// nøyaktig samme komponent. Lintes der, ikke her.
			"prisma/seed.ts",
			"src/components/ui/**"
		],
		"rules": {
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"recommended": true
		}
	}
}
