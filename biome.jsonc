{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": { "ignoreUnknown": false, "ignore": [] },
	// src/components/ui/* er kopiert ordrett fra @tihlde/ui i Photon-monorepoet,
	// og skal kunne kopieres på nytt med `cp` uten at diffen fylles av
	// formateringsstøy. Photon formaterer med oxfmt (4 mellomrom) og sorterer
	// klasser etter oxlints regel; biome ville skrevet begge deler om, og da
	// slutter filene å være identiske med kilden. Derfor er katalogen holdt
	// utenfor både formateraren og linteren. Se CLAUDE.md for synkerutinen.
	"formatter": { "enabled": true, "ignore": ["src/components/ui/**"] },
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"ignore": [
			"src/components/event-calendar/**/*",
			// Hentet uendret fra Photon (packages/ui) for at velgerne skal være
			// nøyaktig samme komponent. Lintes der, ikke her.
			"prisma/seed.ts",
			"src/components/ui/**"
		],
		"rules": {
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"recommended": true
		}
	}
}
