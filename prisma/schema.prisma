// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String  @id
  name                      String
  email                     String
  emailVerified             Boolean @default(true)
  image                     String?
  isAdmin                   Boolean @default(false)
  username                  String? @unique
  emailNotificationsEnabled Boolean @default(true)
  calendarToken     String?  @unique

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  sessions          Session[]
  accounts          Account[]
  memberships       TeamMember[]
  registrations     Registration[]
  attendances       Attendance[]
  pushSubscriptions PushSubscription[]
  groupMemberships  TeamGroupMember[]
  matchEvents       MatchEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Team {
  id   String  @id @default(cuid())
  name String  @unique
  slug String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members TeamMember[]
  events  TeamEvent[]
  groups  TeamGroup[]

  @@map("team")
}

model TeamMember {
  id     String   @id @default(cuid())
  role   TeamRole @default(USER)
  userId String
  teamId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, teamId])
  @@map("team_member")
}

enum TeamRole {
  ADMIN
  SUBADMIN
  USER
}

/// En undergruppe av et lag, f.eks. "11'er" eller "7'er". Lagets egne
/// administratorer oppretter, døper og sletter dem — det finnes ingen
/// forhåndsdefinerte inndelinger, fordi hvert idrettslag deler seg ulikt.
model TeamGroup {
  id          String  @id @default(cuid())
  teamId      String
  name        String
  description String?
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  members TeamGroupMember[]
  events  TeamEventGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
  @@map("team_group")
}

/// Medlemskap i en undergruppe. En spiller kan være med i flere samtidig.
/// createdAt brukes av oppmøtestatistikken til å la være å telle
/// arrangementer fra før spilleren ble med i gruppa.
model TeamGroupMember {
  id      String    @id @default(cuid())
  groupId String
  userId  String
  group   TeamGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("team_group_member")
}

model TeamEvent {
  id                   String         @id @default(cuid())
  teamId               String
  eventType            TeamEventType
  name                 String
  startAt              DateTime
  endAt                DateTime?
  location             String?
  note                 String?
  registrationDeadline DateTime?
  team                 Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  attendances          Attendance[]
  invitedGroups        TeamEventGroup[]
  match                Match?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("team_event")
}

enum TeamEventType {
  TRAINING
  MATCH
  SOCIAL
  OTHER
}

/// Hvilke undergrupper et arrangement er åpent for. Ingen rader betyr at
/// hele laget er invitert — det er standarden, og det alle arrangementer
/// som fantes før undergruppene ble innført fortsetter å være.
/// Resultatet av en kamp. Henger på arrangementet, ett til ett.
model Match {
  id        String @id @default(cuid())
  eventId   String @unique
  homeGoals Int    @default(0)
  awayGoals Int    @default(0)

  event  TeamEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  events MatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("match")
}

/// Én rad per hendelse, ikke tellere. Tre mål av samme spiller er tre rader.
/// Det gjør det like enkelt å slette en feilføring som å legge til.
model MatchEvent {
  id      String         @id @default(cuid())
  matchId String
  userId  String
  type    MatchEventType

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([userId])
  @@map("match_event")
}

enum MatchEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  MOTM
}

model TeamEventGroup {
  eventId String
  groupId String
  event   TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group   TeamGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([eventId, groupId])
  @@index([groupId])
  @@map("team_event_group")
}

model Registration {
  id      String           @id @default(cuid())
  userId  String
  eventId String
  type    RegistrationType
  comment String?
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   TeamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, eventId])
  @@map("registration")
}

enum RegistrationType {
  ATTENDING
  NOT_ATTENDING
}

model Attendance {
  id      String           @id @default(cuid())
  userId  String
  eventId String
  status  AttendanceStatus
  source  AttendanceSource @default(RSVP)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   TeamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, eventId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceSource {
  RSVP
  MANUAL
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("push_subscription")
}
